# Copy this file to .env for local overrides. Never place real secrets in this tracked template.
# scripts/start-local-stack.ps1 loads .env automatically; existing PowerShell environment variables take precedence.
ORIGINGUARD_ENV=local
POSTGRES_DB=originguard
POSTGRES_USER=originguard
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=15432
REDIS_PORT=6379
RABBITMQ_PORT=25672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=originguard
RABBITMQ_DEFAULT_PASS=change-me
AGENT_ASYNC_ENABLED=true
AGENT_QUEUE=originguard.agent.analysis
AGENT_CACHE_ENABLED=true
AGENT_CACHE_TTL=PT6H
AGENT_REQUESTS_PER_MINUTE=20
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=originguard
MINIO_ROOT_PASSWORD=change-me-now
MINIO_BUCKET=originguard-media
MINIO_ENDPOINT=http://localhost:9000
MEDIA_MAX_UPLOAD_BYTES=26214400
SERVER_PORT=18080
MODEL_API_PORT=8090
EMBEDDING_PROVIDER=bge-small-zh-v1.5
MODEL_API_BASE_URL=http://127.0.0.1:8090
AIGC_DETECTOR_PROVIDER=model-api
AIDE_DEVICE=cpu
AIDE_PRECISION=auto
MEDIA_TYPE_CLASSIFIER_PROVIDER=model-api
CLIP_MODEL_PATH=.runtime/models/clip/ViT-B-32.pt
CLIP_DEVICE=cpu
CLIP_CLASSIFIER_TIMEOUT=PT2M
EMBEDDING_MODEL_PATH=.runtime/models/bge-small-zh-v1.5
HF_HOME=.runtime/cache/huggingface
TORCH_HOME=.runtime/cache/torch
EMBEDDING_DEVICE=auto
OPENALEX_API_KEY=
ASSISTANT_LLM_PROVIDER=local-qwen
WEB_SEARCH_PROVIDER=auto
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT=PT20S
RAG_KNOWLEDGE_EXPANSION_TIMEOUT=PT20S
AGENT_PLANNER_PROVIDER=fake
QWEN_VL_BASE_URL=http://127.0.0.1:8092
QWEN_VL_MODEL=qwen3-vl-4b-instruct-q4-k-m
QWEN_VL_TIMEOUT=PT5M
QWEN_VL_MAX_IMAGE_EDGE=896
C2PA_SIDECAR_PORT=8091
C2PA_ENABLED=false
C2PA_BASE_URL=http://127.0.0.1:8091
C2PA_TIMEOUT=PT45S
ORIGINGUARD_JWT_SECRET=replace-with-at-least-32-random-bytes
ORIGINGUARD_DEMO_PASSWORD=replace-local-demo-password
REFRESH_COOKIE_SECURE=false
